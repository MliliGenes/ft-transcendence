# PostgreSQL credentials shared by user-db and user-service.
# Copy to user-db.env and replace every <...> value.
# Postgres uses these values to initialize a NEW data directory.
# Editing them later does not rename an existing database or reset its password.

# Database login created by the Postgres image; separate from an app user/admin.
POSTGRES_USER=<nook_user>

# Generate a unique password. This is also the password user-service connects with.
# Single-quote a real value containing $ or # in the local .env file.
POSTGRES_PASSWORD=<GENERATE_A_UNIQUE_USER_DATABASE_PASSWORD>

# Database created on first startup. Its tables are managed by Prisma migrations.
POSTGRES_DB=<nook_users>
