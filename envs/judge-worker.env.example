JUDGE_WORKER_TOKEN=<GENERATE_A_LONG_RANDOM_SHARED_TOKEN>
JUDGE_WORKER_PORT=3010
JUDGE_DOCKER_BIN=docker
JUDGE_PYTHON_IMAGE=python:3.12-slim
JUDGE_GCC_IMAGE=gcc:14-bookworm
JUDGE_WORKER_CONCURRENCY=2
JUDGE_WORKER_MAX_QUEUE=8
JUDGE_WORKER_QUEUE_TIMEOUT_MS=30000
JUDGE_WORKER_JOB_TIMEOUT_MS=900000

# Judge container CPU limit enforcement:
# JUDGE_CPU_LIMIT_ENABLED defaults to strict true (enforces --cpus on evaluation containers).
# Only an explicit case-insensitive trimmed value of "false" opts out of passing --cpus.
# School/rootless environment note: In rootless or restricted environments (such as school
# machines or unprivileged container runtimes) where host cgroups lack CPU quota delegation
# ("NanoCPUs unsupported"), set JUDGE_CPU_LIMIT_ENABLED=false in the local git-ignored env file only.
# Retained isolation boundaries: Even with CPU limits disabled, all other container boundaries
# remain strictly enforced:
#   - memory limit: 64MiB (--memory 64m)
#   - memory-swap limit: 64MiB (--memory-swap 64m)
#   - process limit: 16 pids (--pids-limit 16)
#   - network: none (--network none)
#   - read-only root filesystem (--read-only, tmpfs /scratch and /tmp with size cap)
#   - capability drop: ALL (--cap-drop=ALL, --security-opt=no-new-privileges)
#   - unprivileged non-root user (--user nobody)
# Tradeoff: Disabling CPU limits introduces CPU contention risk under concurrent workloads.
# Physical school hardware verification remains pending.
# JUDGE_CPU_LIMIT_ENABLED=true
