NODE_ENV=production
PORT=3000
POSTGRES_HOST=user-db
POSTGRES_PORT=5432
# Match user-db.env.
POSTGRES_USER=nook_user
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=nook_users

# RabbitMQ used to publish user lifecycle events to the user.events exchange.
MQ_HOST=rabbitmq
MQ_PORT=5672
# Credentials are supplied by rabbitmq.env through Compose.

# Initial application superadmin (required when no superadmin exists).
# Username: 3–30 characters. Password: 8–32 characters, max 72 UTF-8 bytes.
# Existing superadmins and passwords are preserved on subsequent starts.
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Required by existing user authentication; paste a matching RSA PEM pair.
# Literal \n separators are supported by the app. These are not API keys.
JWT_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----'
JWT_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----'

# Local OAuth: register these callback URLs in each provider application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://localhost/api/auth/discord/callback
DISCORD_LINK_REDIRECT_URI=https://localhost/api/auth/discord/link/callback
AUTH_FRONTEND_URL=https://localhost
GITHUB_REDIRECT_URI=https://localhost/api/auth/github/callback
GITHUB_LINK_REDIRECT_URI=https://localhost/api/auth/github/link/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
