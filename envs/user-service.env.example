PORT=3000

# Database and RabbitMQ credentials are supplied by their shared env files in Compose.
# Compose sets POSTGRES_HOST/PORT and RABBITMQ_HOST/PORT to the container service names.

# Initial application superadmin (required when no superadmin exists).
# Username: 3–30 characters. Password: 8–32 characters, max 72 UTF-8 bytes.
# Existing superadmins and passwords are preserved on subsequent starts.
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
