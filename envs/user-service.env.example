# User-service networking, required email transport, and initial app admin.
# Copy to user-service.env and replace every <...> value.
# NODE_ENV, database credentials, RabbitMQ credentials, and JWT/OAuth settings
# are supplied by backend.env, user-db.env, rabbitmq.env, and user-auth.env.

# Internal HTTP listening port. Keep 3000 with the current Nginx upstream.
PORT=<3000>

# Docker Compose database hostname and container port (not a host-published port).
POSTGRES_HOST=<user-db>
POSTGRES_PORT=<5432>

# Docker Compose broker hostname and AMQP port; 15672 is the management UI port.
RABBITMQ_HOST=<rabbitmq>
RABBITMQ_PORT=<5672>

# Required email transport for verification and password-reset messages.
# MailService requires all four SMTP settings during application startup.
# SMTP_HOST is a hostname only, without smtp:// or https://.
SMTP_HOST=<smtp.example.com>

# Use your provider's port. 587 commonly uses STARTTLS; 465 enables implicit TLS.
# The current mail implementation selects implicit TLS only for port 465.
SMTP_PORT=<587>

# Authentication username, also used as the sender's email address.
SMTP_USERNAME=<noreply@example.com>

# SMTP credential or app-specific password issued by the mail provider.
SMTP_PASSWORD=<SMTP_PROVIDER_PASSWORD_OR_APP_PASSWORD>

# Initial application superadmin. Required by Compose startup on a fresh database.
# This is an application account, not the PostgreSQL administrator.
# Existing superadmins and their passwords are preserved on subsequent starts.
# Changing these variables is NOT a password-reset operation.
# Username: 3-30 characters. Email: a valid email address.
SUPERADMIN_USERNAME=<nook_admin>
SUPERADMIN_EMAIL=<admin@example.com>

# Choose a unique password: 8-32 characters and at most 72 UTF-8 bytes.
# Single-quote the real password if it contains $ or #.
SUPERADMIN_PASSWORD=<UNIQUE_ADMIN_PASSWORD_8_TO_32_CHARS>
