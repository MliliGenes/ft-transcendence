# PostgreSQL credentials shared by chat-db and chat-service.
# Copy to chat-db.env and replace every <...> value.
# Postgres uses these values only when initializing NEW database storage.
# Keep Chat's database and credentials separate from the user database.

# Database login created by the Postgres image.
POSTGRES_USER=<nook_chat>

# Generate a unique password; chat-service reads this same shared setting.
# Changing this file does not reset the password in an existing database.
POSTGRES_PASSWORD=<GENERATE_A_UNIQUE_CHAT_DATABASE_PASSWORD>

# Database created on first startup; Chat applies its own Prisma migrations.
POSTGRES_DB=<nook_chat>
