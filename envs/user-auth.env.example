# User-service JWT keys, frontend origin, and OAuth provider configuration.
# Copy to user-auth.env and replace every <...> value.
# Keep real keys and provider secrets only in the ignored local file.

# Generate an RSA key pair from user-service with:
# node scripts/generate-jwt-keys.mjs
# Paste the complete .keys/jwt-private.pem contents as a single quoted value,
# using literal \n between PEM lines, including the BEGIN/END lines.
# Only user-service receives the private signing key.
JWT_PRIVATE_KEY=<RSA_PRIVATE_KEY_PEM_WITH_LITERAL_BACKSLASH_N>

# Matching complete .keys/jwt-public.pem contents, using the same encoding.
# Copy this public key (never the private key) into chat-service.env and
# game-service.env as well.
JWT_PUBLIC_KEY=<MATCHING_RSA_PUBLIC_KEY_PEM_WITH_LITERAL_BACKSLASH_N>

# Public frontend origin, with no trailing slash.
# Used for OAuth returns, trusted browser origins, and verification/reset emails.
AUTH_FRONTEND_URL=<https://localhost:8443>

# Discord OAuth application credentials from the Discord developer portal.
# Optional provider: replace these with real credentials to enable it, or leave
# BOTH ID and secret empty in the local file if Discord sign-in is not configured.
DISCORD_CLIENT_ID=<DISCORD_APPLICATION_CLIENT_ID>
DISCORD_CLIENT_SECRET=<DISCORD_APPLICATION_CLIENT_SECRET>

# Register BOTH exact HTTPS URLs below in the Discord application.
# Login may create an account; linking connects Discord to an existing account.
DISCORD_REDIRECT_URI=<https://localhost:8443/api/auth/discord/callback>
DISCORD_LINK_REDIRECT_URI=<https://localhost:8443/api/auth/discord/link/callback>

# GitHub OAuth application credentials from GitHub developer settings.
# Optional provider: configure both values, or leave both empty in the local file.
GITHUB_CLIENT_ID=<GITHUB_OAUTH_APPLICATION_CLIENT_ID>
GITHUB_CLIENT_SECRET=<GITHUB_OAUTH_APPLICATION_CLIENT_SECRET>

# Ensure the GitHub application's callback configuration permits these routes.
# Keep the /api prefix: Nginx receives these public callbacks before proxying them.
GITHUB_REDIRECT_URI=<https://localhost:8443/api/auth/github/callback>
GITHUB_LINK_REDIRECT_URI=<https://localhost:8443/api/auth/github/link/callback>
