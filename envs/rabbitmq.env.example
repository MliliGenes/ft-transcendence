# Broker credentials shared by rabbitmq, user-service, and chat-service.
# Copy to rabbitmq.env and replace every <...> value.
# RabbitMQ creates this user on first initialization of its data directory.
# Editing this file does not rotate credentials in an existing broker.

# Both backend services authenticate as this broker user.
RABBITMQ_DEFAULT_USER=<nook_rabbitmq>

# Generate a unique broker password, distinct from database/storage passwords.
RABBITMQ_DEFAULT_PASS=<GENERATE_A_UNIQUE_RABBITMQ_PASSWORD>
