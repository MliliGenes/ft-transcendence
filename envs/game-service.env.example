SERVICE_NAME=game
PORT=3002
JUDGE_BACKEND=worker
JUDGE_WORKER_URL=http://judge-worker:3010
JUDGE_WORKER_TOKEN=<GENERATE_A_LONG_RANDOM_SHARED_TOKEN>
JUDGE_WORKER_TIMEOUT_MS=930000
DEV_PRINCIPAL=false
RECONNECT_GRACE_MS=90000
# Use the same values as envs/game-db.env.
DATABASE_URL=postgres://<GAME_DB_USER>:<GAME_DB_PASSWORD>@game-db:5432/<GAME_DB_NAME>
POSTGRES_HOST=game-db
# Matching verification key only; never copy JWT_PRIVATE_KEY into this file.
JWT_PUBLIC_KEY=<SAME_RSA_PUBLIC_KEY_AS_USER_AUTH_WITH_LITERAL_BACKSLASH_N>

# Direct ContainerJudge CPU limit enforcement (when JUDGE_BACKEND=container):
# JUDGE_CPU_LIMIT_ENABLED defaults to strict true. Only explicit case-insensitive trimmed "false"
# opts out of passing --cpus. Use false in local git-ignored envs only for rootless/school environments
# lacking cgroup cpu quota delegation. All memory/pids/network/read-only/nonroot limits remain retained.
# Tradeoff: CPU contention risk; physical school hardware check pending.
# JUDGE_CPU_LIMIT_ENABLED=true
