# Passwords for the read-only `monitoring` PostgreSQL login (pg_monitor role).
# Copy to monitoring.env and replace every <...> value.
# Loaded by user-db and chat-db (to create the login) and by Alloy (to connect).
# A NEW database creates the login automatically. For an existing database, run:
#   docker compose exec user-db sh /docker-entrypoint-initdb.d/10-monitoring-role.sh
#   docker compose exec chat-db sh /docker-entrypoint-initdb.d/10-monitoring-role.sh
USER_DB_MONITOR_PASSWORD=<USER_DB_MONITOR_PASSWORD>
CHAT_DB_MONITOR_PASSWORD=<CHAT_DB_MONITOR_PASSWORD>
