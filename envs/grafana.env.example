# Grafana administrator login, used at https://localhost:8443/grafana/.
# Copy to grafana.env and replace every <...> value.
# Grafana only applies these on the first start of an empty grafana-data volume;
# change the password later from Grafana's profile page.
GF_SECURITY_ADMIN_USER=<ADMIN_USERNAME>
GF_SECURITY_ADMIN_PASSWORD=<ADMIN_PASSWORD>
