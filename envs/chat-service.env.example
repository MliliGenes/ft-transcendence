PORT=3000

# MinIO's internal address is used for server-side object operations.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET=chat-attachments

# Use a dedicated MinIO service account with access limited to this bucket.
MINIO_ACCESS_KEY=replace-with-chat-storage-user
MINIO_SECRET_KEY=replace-with-chat-storage-password

# The browser must be able to reach this host for presigned upload/download URLs.
# Local Compose publishes MinIO on localhost:9000; use your public proxy hostname in production.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false

# Internal Docker URL used only to bootstrap missing public ChatUser profiles.
USER_SERVICE_URL=http://user-service:3000

# Database and RabbitMQ credentials are supplied by their shared env files in Compose.
# Compose sets POSTGRES_HOST/PORT and RABBITMQ_HOST/PORT to the container service names.

# Copy only the User service's public verification key. Never copy its private key.
JWT_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----'
