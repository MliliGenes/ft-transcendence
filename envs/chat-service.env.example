# Chat networking, JWT verification, and attachment storage.
# Copy to chat-service.env and replace every <...> value.
# NODE_ENV, database credentials, and broker credentials are supplied by
# backend.env, chat-db.env, and rabbitmq.env; do not duplicate them here.

# Internal HTTP/Socket.IO port. Keep 3000 with current Nginx/healthcheck settings.
PORT=<3000>

# Internal Docker Compose database hostname and container port.
POSTGRES_HOST=<chat-db>
POSTGRES_PORT=<5432>

# Internal Docker Compose RabbitMQ hostname and AMQP port.
RABBITMQ_HOST=<rabbitmq>
RABBITMQ_PORT=<5672>

# Internal HTTP origin used to fetch missing public user profiles.
# This is a server-to-server address, not a browser-facing URL.
USER_SERVICE_URL=<http://user-service:3000>

# Exact public key paired with JWT_PRIVATE_KEY in user-auth.env.
# Paste the complete PEM as a single quoted value with literal \n separators.
# Shape: '-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----'
# Never give Chat the private signing key.
JWT_PUBLIC_KEY=<SAME_RSA_PUBLIC_KEY_AS_USER_AUTH_WITH_LITERAL_BACKSLASH_N>

# Internal object-storage connection used for server-side operations.
# Endpoint is a hostname only: no scheme, path, or embedded port.
# Local MinIO serves HTTP inside Compose; Nginx handles browser-facing TLS.
MINIO_ENDPOINT=<minio>
MINIO_PORT=<9000>
MINIO_USE_SSL=<false>

# Signing region; use the same region on MinIO and both storage clients.
MINIO_REGION=<us-east-1>

# Private attachment bucket. Provision it before attempting uploads.
MINIO_BUCKET=<chat-attachments>

# Create a dedicated MinIO user/service account restricted to this bucket.
# Obtain these credentials from your storage administrator; do not reuse root.
MINIO_ACCESS_KEY=<CHAT_STORAGE_SERVICE_ACCOUNT_ACCESS_KEY>
MINIO_SECRET_KEY=<CHAT_STORAGE_SERVICE_ACCOUNT_SECRET_KEY>

# Browser-reachable S3 endpoint for signed uploads, previews, and downloads.
# Endpoint is a hostname only. The local Nginx TLS proxy is https://localhost:9443.
# The current Compose port binding is loopback-only. Remote clients need a
# reachable HTTPS hostname, matching certificate, and corresponding proxy binding.
MINIO_PUBLIC_ENDPOINT=<localhost>
MINIO_PUBLIC_PORT=<9443>
MINIO_PUBLIC_USE_SSL=<true>
