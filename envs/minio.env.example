# MinIO server administration and browser CORS settings.
# Copy to minio.env and replace every <...> value.
# Loaded only by MinIO. Chat uses its own restricted storage credentials.

# Administrative account for the local console at http://localhost:9001.
MINIO_ROOT_USER=<nook_minio>

# Generate a strong, unique administrative password.
# Do not copy this root password into chat-service.env.
MINIO_ROOT_PASSWORD=<GENERATE_A_UNIQUE_MINIO_ADMIN_PASSWORD>

# Comma-separated browser origins allowed to upload directly to signed URLs.
# An origin includes scheme and optional port, with no path or trailing slash.
# The current Compose frontend uses https://localhost; add another origin only
# when serving the frontend from it. Do not use * for a private deployment.
MINIO_API_CORS_ALLOW_ORIGIN=<https://localhost>
