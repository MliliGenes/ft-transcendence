plan:
  title: Nook chat integration
  design_companion: CHAT_DESIGN_PROPOSAL.toon
  status: proposed
  reviewed_on: 2026-11-07
  deliverable: Planning only; no application or backend changes authorized by this document
  goal: Replace the Chat placeholder with a reliable social messaging workspace using actual Chat-service capabilities
  approach: Ship direct messages first; extend the same conversation view to groups and attachments in separate milestones
  authorship: The user implements each slice; the assistant explains contracts and reviews specific stuck points unless explicitly asked to implement
  evidence_rule: Current source wins over stale prose; recheck contracts before starting implementation

sources[17]{id,path,purpose}:
  api,../chat-service/docs/API.md,HTTP and Socket.IO documentation
  spec,../chat-service/openAPI.json,OpenAPI 3.1 request and response schemas
  uploads,../chat-service/docs/MINIO_ATTACHMENTS.md,Implemented attachment flow and limitations
  overview,../chat-service/docs/CHAT_OVERVIEW.md,Historical context rather than authoritative feature inventory
  controller,../chat-service/src/chat/chat.controller.ts,Actual endpoints and guards
  service,../chat-service/src/chat/chat.service.ts,Access checks and message persistence
  gateway,../chat-service/src/chat/gateway/chat.gateway.ts,Actual socket events and authentication lifecycle
  groups,../chat-service/src/chat/groups/groups.service.ts,Group roles and channel membership
  eligibility,../chat-service/src/chat/user-profiles.service.ts,Active users and block checks
  storage,../chat-service/src/minio/minio.service.ts,Upload policy and preview restrictions
  schema,../chat-service/prisma/schema.prisma,Message versions and uniqueness constraints
  proxy,../nginx/default.conf,Canonical browser API and socket transport routes
  auth,components/auth/auth-provider.tsx,In-memory sessions and shared refresh retry
  social,lib/social/client.ts,Existing friends and request query
  images,lib/accounts/images.ts,Safe account avatar URL normalization
  reference,../auth-profile-web/src/pages/ChatPage.jsx,Existing tester behavior; not a component to copy wholesale
  design,NOOK_DESIGN_SYSTEM.json,Nook theme and layout tokens

external_references:
  toon_spec: "https://github.com/toon-format/spec/blob/main/SPEC.md"
  toon_validation: "https://toonformat.dev/cli/"
  socket_options: "https://socket.io/docs/v4/client-options/"
  next_guidance: node_modules/next/dist/docs/01-app/01-getting-started/03-layouts-and-pages.md

scope:
  milestone_1: Authenticated DM directory; open or create DM; paginated history; send and retry; own-message edit/delete; unread state; live new messages
  milestone_2: Presence and group/channel conversation views with role-aware management
  milestone_3: Private image/PDF attachment upload; safe image previews; downloads
  contact_policy: Default to any active non-self user the backend permits; friends are convenient suggestions rather than a security prerequisite
  contact_policy_evidence: ensureCanContact checks blocks in either direction; Chat does not require an accepted friendship
  product_confirmation: Confirm the contact policy before implementation; friends-only messaging would require an explicit server policy change
  backend_changes: Separate proposed work requiring agreement; do not silently change existing API response shapes
  exclusions[11]: typing indicators,reactions,voice and video calls,push notifications,read receipts for other people,message search,threads and replies,message pinning,public group discovery,group invitations,offline persistent outbox
  exclusions_note: No controls for unsupported features; schema enums or tables alone are not usable endpoints

contract_drift[6]{id,finding,decision,evidence}:
  D1,API limitations incorrectly say presence is absent,Use implemented presence events; correct prose when implementation begins,gateway
  D2,OpenAPI lacks attachment routes and message attachment fields,Type from controller and DTOs; synchronize docs before attachment delivery,controller
  D3,Older overview says group endpoints are future work,Groups are implemented; include a separate milestone,groups
  D4,API emphasizes active-user checks only on groups,ChatController also applies EnsureActiveUserGuard; local tombstone checks are not continuous upstream revalidation,controller
  D5,History returns a raw array with one extra lookahead record,Use the explicit legacy adapter below or agree a versioned envelope first,service
  D6,Message idempotency prose describes only conversation and text,Current request hash also includes the ordered attachment keys,service

transport:
  rest_base: /api/chat
  upstream_rest_base: /chat
  namespace: /chat
  socket_path: /api/chat/socket.io/
  socket_origin: Current browser origin
  distinction: Namespace is not the transport path; do not connect to the /api/chat namespace
  authentication: HTTP Authorization Bearer header; Socket.IO handshake auth.token from the in-memory session
  refresh: Reuse requestWithSession for one HTTP 401 refresh-and-retry; never create a second token store
  deployment: Validate through the existing HTTPS nginx entry point; standalone Next dev does not proxy the APIs
  dependency: Add only socket.io-client with a compatible 4.x version when implementing live delivery; native WebSocket cannot speak Socket.IO
  response_parser: Handle 204 and empty successful bodies including the current read-state 200; never unconditionally parse JSON
  errors: Preserve numeric status and safe text; support Nest message strings or arrays plus non-JSON proxy failures

http_core[10]{method,path,request,response_or_rule}:
  POST,/conversations/dm,userId UUID,201 bare existing or created conversation; refetch enriched DM list
  GET,/conversations,none,200 raw DM array with both public profiles and caller read state; no latest-message summary
  GET,/conversations/{conversationId}/messages,limit 1..100 default 50; optional before UUID,200 newest-first raw messages; currently up to limit plus one
  POST,/conversations/{conversationId}/messages,trimmed content 1..2000; clientRequestId UUID; optional attachments,201 stored message with author; one request ID per logical send
  PATCH,/conversations/{conversationId}/read-state,messageId UUID,200 empty body; marker belongs to this conversation
  PATCH,/messages/{messageId},trimmed content 1..2000,200 updated own undeleted message with incremented version
  DELETE,/messages/{messageId},none,204 soft deletion; only author; content cleared and version incremented
  POST,/conversations/{conversationId}/attachments/upload-url,allowed contentType,objectKey uploadUrl method fields expiresInSeconds maxBytes
  GET,/conversations/{conversationId}/attachments/preview-url,objectKey query parameter,contentType and nullable previewUrl; non-deleted reference required
  GET,/conversations/{conversationId}/attachments/download-url,objectKey query parameter,url; non-deleted reference required

http_groups[15]{method,path,request_or_permission}:
  POST,/groups,name 1..100; optional nullable description up to 1000 and rules up to 4000; creator becomes ADMIN with general channel
  GET,/groups,Caller memberships only; includes caller role and channel summaries
  GET,/groups/{groupId},Member access; details and channels
  PATCH,/groups/{groupId},Admin; supplied name description or rules only
  DELETE,/groups/{groupId},Admin; 204; cascades channels and messages
  GET,/groups/{groupId}/members,Member; role joinedAt and nested public user
  POST,/groups/{groupId}/members,Admin; userId; active user added directly as MEMBER; duplicate 409
  PATCH,/groups/{groupId}/members/{userId}/role,Admin; role ADMIN or MEMBER; last-admin conflict 409
  DELETE,/groups/{groupId}/members/me,Leave; 204; last admin cannot leave
  DELETE,/groups/{groupId}/members/{userId},Admin; remove member; 204; last admin protected
  GET,/groups/{groupId}/channels,Member; creation order with per-channel caller unread state
  GET,/groups/{groupId}/channels/{channelId},Member; channel must belong to requested group
  POST,/groups/{groupId}/channels,Admin; name 1..80 and optional nullable topic up to 500
  PATCH,/groups/{groupId}/channels/{channelId},Admin; supplied name or topic; null clears topic
  DELETE,/groups/{groupId}/channels/{channelId},Admin; 204; removes channel and messages

socket_events[4]{direction,event,payload,handling}:
  server_to_client,message:created,Stored Message including author and attachments,Merge by message ID; reconcile pending request ID; invalidate related list
  server_to_client,presence:snapshot,users array of userId and status,Merge authorized audience snapshot; clear old audience on session change
  server_to_client,presence:changed,userId and status,Update known presence state without deriving last-seen timestamps
  client_to_server,presence:activity,No payload,Throttle actual visible keyboard or pointer activity to at most once per 30 seconds

data_shapes:
  conversation: DM has dmUserAId and dmUserBId; CHANNEL has groupId name and topic; channel ID is its conversation ID
  public_profile: id username displayName avatarUrl; do not add email or provider details
  message: id conversationId authorId author content nullable attachments createdAt editedAt nullable deletedAt nullable clientRequestId requestHash version
  message_projection: Ignore requestHash for presentation; preserve ordering and version metadata needed for reconciliation
  order: Stable ascending createdAt then ID in the rendered timeline; history API returns descending order
  deletion: Render a Message deleted tombstone and hide its text and attachment previews
  presence: ONLINE AWAY OFFLINE; missing snapshot or disconnected transport is Unknown rather than proof of Offline
  presence_semantics: Five minutes without activity becomes AWAY; final socket disconnect becomes OFFLINE; memory resets on server restart

ui:
  design: Existing shadcn Base UI primitives and Tabler icons; square surfaces; theme tokens; orange accents; existing atmospheric background
  desktop: Conversation directory beside one active timeline; composer stays inside the content viewport; retain the existing application sidebar
  mobile: Directory or active thread one at a time; Back to chats action; avoid stacking an extra permanent sidebar
  directory: Direct messages first; Groups section added in milestone 2; local filtering of loaded names only
  directory_order: Deterministic alphabetical DM peer name then conversation ID until authoritative last-message metadata exists
  no_fake_previews: Do not label conversation updatedAt as last-message time or fetch every history merely to manufacture preview text
  new_chat: Dialog with friends suggestions and existing paginated public people search; exclude self; create DM only on explicit action
  profile_entry: Add a Message action to another user's public profile using the same create-or-get mutation
  thread: Public name and normalized avatar; linked profile; timestamps; own-message actions; empty conversation prompt
  composer: Multiline textarea; Enter sends and Shift+Enter inserts newline; honor IME composition; visible Send button and length feedback
  scroll: Auto-scroll on initial latest load and own send; incoming messages scroll only near the bottom; otherwise show New messages
  older_history: Accessible Load older messages button; preserve scroll anchor when prepending; no virtualization until measured need
  focus: Keep focus in composer after send; dialogs restore trigger focus; thread navigation has an announced heading and deliberate focus target
  accessibility: Label icon-only controls; 44px touch targets; visible focus; presence and errors use text as well as color
  announcements: Polite new-message and connection status feedback; do not announce the entire fetched history on pagination
  states: Restoring session; signed out; loading; empty; offline or reconnecting; failed request; inaccessible conversation; deleted participant fallback
  auth_guard: Do not fetch private chat data or connect a socket before session restoration succeeds

routes:
  root: /chat
  selected_dm: /chat?conversation=<conversationId>
  selected_channel: /chat?group=<groupId>&conversation=<channelConversationId>
  handling: Validate IDs; update URL with Next navigation; support reload and back-forward; never trust URL IDs as authorization
  route_composition: Keep server-rendered metadata and a small page wrapper; client workspace owns authenticated queries and interactions
  query_suspense: If using useSearchParams wrap the client workspace in Suspense as required by the installed Next version
  invalid_selection: Show a local unavailable-conversation state and return-to-directory action; do not use global 404 for ordinary API failures

client_architecture:
  rest_module: lib/chat/client.ts for typed DTOs and authenticated requests; accept AbortSignal for queries
  queries_module: lib/chat/queries.ts for user-scoped keys and shared query options; use existing TanStack Query
  reconciliation_module: lib/chat/messages.ts for pure sorting deduplication and legacy pagination helpers
  workspace: components/app/chat-workspace.tsx composing directory timeline and composer; split only when each component has a distinct responsibility
  realtime: components/chat/chat-realtime-provider.tsx under AuthProvider inside the signed-in AppShell; one socket per browser tab
  provider_limit: Mount one realtime owner only; do not create one socket per thread or component; retain connection across app navigation
  later_files: Separate groups and attachment UI modules only when those milestones begin
  query_keys: All private keys start with chat and signed-in user ID; include group or conversation ID and pagination parameters as appropriate
  cache_owner: Query cache owns server records; component state owns draft and pending-send UI; no extra global store
  lifecycle: On logout or account switch disconnect socket; remove listeners and timers; cancel old queries; clear private cache and drafts
  late_results: Prevent stale refresh requests and socket callbacks from repopulating the previous user's data after session changes
  dependencies: No UI kit migration or chat SDK; retain existing auth and image helpers; add Socket.IO client only at the realtime milestone

history_and_recovery:
  legacy_adapter: Request limit 50; display only first 50 returned records; hasMore is raw length greater than 50
  next_cursor: Use the last displayed record as before; never use the discarded lookahead record or it will be skipped
  boundary_cases: Empty array ends pagination; exactly 50 means no lookahead; 51 means there is another page
  query_strategy: useInfiniteQuery for older history; flatten and deduplicate by ID before stable chronological sorting
  reconnect: Invalidate directory and selected history on every successful reconnect; socket delivery is not durable
  recovery_gap: Rebuild the selected history from latest and allow older paging; never splice a new first page onto stale old pages with an unfilled gap
  recovery_tradeoff: Resetting history may lose loaded scroll depth; explain refreshing state rather than silently omitting messages
  concurrent_fetch: Buffer live arrivals during snapshot replacement or merge them afterward; a slow GET must not erase newer socket messages
  versions: Keep the highest version for duplicate message IDs; stale events or responses must not resurrect edited or deleted content
  unloaded_threads: Invalidate lists for messages outside the active thread; do not create a fake complete history page from a single socket event
  membership_change: Clear inaccessible histories on 403 or 404 and revalidate group membership after focus or reconnect

send_edit_delete:
  logical_send: Generate crypto.randomUUID once on submission; freeze conversation ID trimmed text and ordered attachment keys together
  retries: Reuse that exact payload and request ID after network uncertainty or 401 refresh; edited retry content is a new logical send
  reconciliation: Socket event may arrive before POST response; match authorId plus clientRequestId then canonical ID so only one message remains
  pending_ui: Show Sending or Failed with explicit Retry; no browser-storage outbox; do not clear newly typed text when an earlier send completes
  mutation_policy: Disable duplicate submit for the pending draft; do not automatically retry non-idempotent group creation or ambiguous edit/delete operations
  edit: Own undeleted message only; inline editor with Save and Cancel; retain original until success; show edited timestamp
  delete: Confirm destructive action; replace with tombstone after success; refetch on ambiguous failure
  remote_updates: There are no edit/delete broadcasts; invalidate locally and refetch visible selected history on focus and a conservative 30-second interval
  polling_budget: Pause polling in hidden tabs; avoid overlapping reconnect and focus refetches; respect nginx 429 limits and backoff
  release_tradeoff: Remote edits/deletes are eventually refreshed rather than instant until an explicit backend event contract is added

read_state:
  meaning: Caller last-read marker and unread count only; not a recipient Seen receipt
  eligibility: Advance only when document is visible and focused and newest confirmed incoming message is actually visible
  behavior: Opening a conversation while scrolled to older messages must not mark unseen messages read
  writes: Coalesce writes; serialize per conversation; remember the newest confirmed position and never intentionally send an older marker
  success: Invalidate caller DM or channel unread query; do not blindly decrement on every duplicate event
  limitation: Client serialization cannot prevent backward movement from another tab; server monotonic updates remain a release gate
  synchronization: No read-state event exists; refetch on focus/reconnect and while relevant chat UI is visible

socket_lifecycle:
  setup: Register message and presence listeners before connect; use current token and clean up each listener explicitly
  connection_states: Connecting Connected Reconnecting Offline and Session expired; socket failure does not erase successfully loaded history
  auth_failure: On Unauthorized connect_error attempt one shared refresh then reconnect with the returned token; stop and require login if refresh fails
  token_rotation: Update handshake auth after session refresh and reconnect; coordinate a refresh before access-token expiry using expiresIn and acquisition time
  resume: Recheck freshness on browser focus or resume because background timers are throttled
  retries: Use Socket.IO bounded reconnection backoff for transport errors; do not treat every outage as an authentication failure
  server_disconnect: Explicit server disconnect may require a manual reconnect after refresh; do not enter an unlimited Unauthorized loop
  read_vs_delivery: Receiving an event is neither proof that it was displayed nor proof that the recipient read it
  presence: Send activity only from real visible user interaction; heartbeat timers are not activity
  presence_audience: Current audience is existing DM partners and group members; a newly created relationship may need a fresh snapshot on reconnect

groups:
  navigation: Load memberships separately from DMs; expand chosen group into channels; use the same timeline and composer for channel IDs
  management: Create group; edit name description rules; list members; add existing users; promote or demote; remove or leave; create edit delete channels
  permissions: Render admin controls only for current ADMIN role; server remains authoritative and 403 refreshes role state
  conflicts: Explain duplicate-member and last-admin 409s; offer promoting another member or deleting the group where permitted
  selection: After deletion or leaving clear invalid selected IDs and cached content; move to a remaining channel or directory
  mutations: Invalidate affected memberships details channels members and unread queries; no speculative membership socket events
  notifications: Group changes are not broadcast by the current gateway; refresh relevant data on focus/reconnect and show stale-role errors safely
  destructive_copy: Warn that deleting a group or channel removes its messages; leaving is not deletion

attachments:
  enabled_after: HTTPS storage path and cross-origin upload policy pass real-browser validation
  limits: Up to 5 files per message; each 1 byte to 10 MiB; JPEG PNG WebP GIF or PDF; content text remains required
  upload_flow: Request POST policy per file; append returned fields and then file to FormData; upload to returned uploadUrl; send object keys with message
  upload_headers: Do not set multipart Content-Type manually and do not forward the application bearer token to object storage
  retry: Retain successful keys in memory for the same draft; retry only failed uploads; keep attachment order stable for idempotency
  cancellation: Abort outstanding requests when draft is discarded or user logs out; revoke local preview object URLs
  previews: Request preview-url for visible attachments; render only permitted image types; PDF remains a download card
  private_images: Use direct browser image loading for signed URLs; avoid a shared Next image-optimizer cache for private capabilities
  urls: Validate HTTPS and exact configured storage origin; never rewrite a signed URL host or path after signing
  expiry: Signed POST and GET capabilities last 300 seconds; fetch fresh URLs when needed and expire client preview caches before them
  downloads: Fetch a fresh download URL on action; use safe navigation and noreferrer; never log signed URLs or persist them in browser storage
  metadata: History stores object keys only; do not invent original filename or size; use neutral Attachment labels where metadata is unavailable
  removal: Hide previews immediately on deleted messages or lost membership; already-issued URLs may remain usable until expiry
  lifecycle_limit: No abandoned-upload or deleted-message object cleanup exists; document retention and schedule backend cleanup separately
  security_limit: Declared MIME is not content verification; signature checks and a safe untrusted-file policy are needed before public rollout

backend_gates[9]{id,priority,observation,required_decision_or_fix,evidence}:
  G1,before production,History and read endpoints check membership but not DM block eligibility,Define retained-history policy explicitly and regression-test block behavior across all operations,service
  G2,before production,Edit/delete filter only author and deletedAt rather than current group membership,Require conversation authorization for mutations or explicitly approve retained author rights after removal,service
  G3,before production,Socket JWT is checked at handshake with no expiry timer or active-user recheck,Enforce token expiry and account-deletion/revocation policy server-side; client logout is not enforcement,gateway
  G4,before unread release,Read marker upsert allows backward movement,Implement atomic monotonic createdAt-plus-ID advancement and test concurrent tabs,service
  G5,before robust history release,Cursor is not explicitly scoped to conversation and raw response leaks lookahead,Validate cursor ownership; retain legacy adapter or agree and document an envelope migration,service
  G6,before retry guarantee,DM creation and send use lookup then insert with unhandled unique races,Handle uniqueness races by rereading canonical row and verifying original request hash,service
  G7,before attachments,Example storage endpoint is HTTP localhost port 9000 while Nook is HTTPS,Provide reachable trusted HTTPS storage origin and exact CORS policy; test signatures without URL rewrites,storage
  G8,before public attachments,Uploaded content is checked for key ownership and size but not signatures,Choose server-side content validation and safe serving policy; handle missing object or storage outage without raw internal errors,storage
  G9,before production,No explicit gateway origin allowlist or socket-event rate control appears in inspected setup,Verify deployment controls and add origin validation plus bounded activity/connection abuse controls,gateway

gate_notes:
  evidence_scope: Static inspection of listed files only; these are targeted review gates rather than a completed security audit or proven exploit report
  scope_control: Backend contract changes are not required to draft the client but unresolved release gates must not be presented as production-ready behavior
  no_false_promise: Client hiding and refresh logic cannot fix authorization or socket revocation gaps
  optional_api_improvements: Latest-message summaries and ordering; edit/delete/read/group-change events; incremental catch-up cursor; not invented in the first client
  storage_proxy: If a new storage proxy is chosen its upload body limit must exceed 10 MiB plus multipart overhead; current nginx default is 6 MiB
  block_privacy: Do not disclose who blocked whom; show a generic contact unavailable message

errors[8]{status,ui,recovery}:
  0,Connection unavailable; retain draft,Manual retry with same send request ID
  400,Show relevant safe validation message,Correct input; no blind retry
  401,Session recovery then sign-in prompt if needed,One shared refresh; stop sockets and clear private state on terminal failure
  403,Contact unavailable or permission changed,Disable affected action and refetch membership; never bypass on client
  404,Conversation message or participant unavailable,Clear inaccessible selection; retain safe navigation back
  409,Explain request-ID mismatch or membership conflict,Refetch relevant state; do not silently generate a new ID for uncertain send
  429,Too many requests; temporary retry delay,Respect Retry-After when provided and throttle polling
  503,Chat dependency temporarily unavailable,Retain draft and permit explicit retry; no claim that user or conversation was deleted

implementation_phases[9]{id,title,depends_on,deliverable,acceptance,learning_checkpoint}:
  P0,Agree contracts and release gates,none,Confirm contact scope; map docs drift and backend owners; no application edits yet,User distinguishes currently usable endpoints from proposed backend work,Explain why namespace and transport path differ
  P1,Typed HTTP boundary,P0,DTOs response parsing error mapping query keys and legacy page adapter,Empty 200 and 204 work; 401 refresh once; cursor tests pass,Explain query keys and why tokens stay out of them
  P2,Read-only DM workspace,P1,Directory selected URL state history pagination safe avatars and signed-out states,Direct link and mobile navigation work without lost or duplicated history,Explain newest-first API versus chronological rendering
  P3,DM actions and unread,P2,Create-or-get send retry own edit/delete and visible-message read tracking,Two users can exchange persisted messages; request IDs survive uncertain retries,Explain one logical send versus repeated HTTP attempts
  P4,Realtime integration,P3,One socket owner event merge reconnect resync and token renewal,HTTP/event races render one message; unrelated user gets none; logout disconnects,Explain why socket delivery is not durable history
  P5,Presence,P4,Audience presence map and throttled activity with Unknown state,Multiple tabs and five-minute idle work without heartbeat-generated activity,Explain connected versus active versus actually reading
  P6,Groups and channels,P4,Membership and channel views plus role-aware administration,Member/admin/outsider scenarios and last-admin protections pass,Explain why an author-only check may be insufficient after removal
  P7,Attachments,P3 and storage gates,Upload policy UI image previews downloads and retry cleanup,HTTPS browser upload works; limits and foreign-key access failures are tested,Explain object keys versus expiring bearer capabilities
  P8,Release verification,P5 P6 P7 and applicable gates,Regression tests browser matrix docs alignment and final diff review,No unresolved security gate is hidden; remaining limitations are recorded,Walk through reconnect and expired-session recovery without assistance

validation:
  execution_status: Planned checks only; no application test or production readiness is claimed by this document
  pure_tests: Legacy 0/50/51 pagination; lookahead cursor; stable ordering; ID dedupe; highest version; POST/event races; attachment order; URL selection
  client_contract_tests: Empty success bodies; malformed error JSON; abort; one-refresh retry; owner-scoped keys; logout cleanup; no private query before restoration
  dm_integration: Two accounts create same DM; self excluded; optional non-friend allowed per chosen policy; blocked or deleted user rejected safely
  message_integration: Whitespace-only and 2001-character failures; timeout after commit; identical retry; changed-payload 409; concurrent retry; soft delete and edit
  realtime_integration: Sender and recipient plus unrelated third account; reconnect after more than one page of missed messages; restart; expired token; account deletion
  history_integration: Equal timestamps; foreign cursor; invalid ID; deleted cursor row policy; no skipped lookahead; prepend scroll anchor; slow GET versus live event
  unread_integration: Own messages excluded; hidden tab and scrolled-up thread not read; latest visible message advances; old concurrent marker cannot regress after G4
  group_integration: Outsider 404; member admin-action 403; direct add; duplicate 409; promote demote leave remove; concurrent last-admin protection; deleted selection
  attachment_integration: Each allowed type; zero and oversized file; sixth file; expired policy; interrupted upload; foreign key; missing object; revoked membership; deleted message
  browser_matrix: Light Dark System; desktop expanded/collapsed shell; narrow mobile; keyboard-only; focus restoration; IME; screen reader announcements; no horizontal overflow
  auth_regression: Landing login registration OAuth and password recovery intact; refresh cookie works through nginx; tokens absent from URLs logs and storage
  security_regression: Plain-text message rendering; no raw HTML; no automatic unsafe URL embedding; image-source restrictions; cross-account cache isolation; socket recipient isolation
  client_commands[4]: npm test,npm run lint,npx tsc --noEmit,npm run build
  backend_commands[3]: npm test,npm run lint,npm run build
  database_tests: From chat-service use the documented isolated test/run-dm-postgres.ps1 flow only with an approved disposable database; never point it at production
  dependencies: Review package and lockfile diff; no empty package versions or unrelated upgrades; socket.io-client is the only planned new runtime package
  final_review: Verify docs match implemented payloads and status codes; distinguish tests actually run from checks still pending

resume:
  first_action: Re-read current API DTOs gateway and nginx config because this plan captures a changing local repository
  first_slice: P0 then P1; do not begin with a large chat UI rewrite
  user_prompt: Describe your proposed HTTP wrapper and the specific part you are unsure about; implement it and bring the diff for review
  progress: All phases pending; no chat implementation performed
