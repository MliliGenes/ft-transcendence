      "title": "Firing and pending alerts",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "options": {
        "alertListOptions": {
          "stateFilter": {
            "firing": true,
            "pending": true
          },
          "viewMode": "list"
        },
        "alertInstanceLabelFilter": "",
        "datasource": "Prometheus",
        "groupMode": "default",
        "maxItems": 20,
        "showInstances": true,
        "sortOrder": 1,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "normal": false,
          "error": true,
          "noData": false
        },
        "viewMode": "list"
      }
