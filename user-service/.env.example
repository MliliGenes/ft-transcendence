# Shared by NestJS, Prisma, and make -C postgres. Set the database credentials below.
# The test container publishes POSTGRES_PORT on this computer; 5433 avoids local 5432.
# Test database storage is temporary: stopping its container discards the data.
NODE_ENV=development
PORT=3000
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=nook_test
POSTGRES_PASSWORD=
POSTGRES_DB=nook_users

# Matching RSA PEM key contents; replace placeholders in your local .env.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Discord OAuth: create an app and register this exact redirect URI.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
