# Standalone user-service development (NestJS, Prisma, and make -C postgres).
# Copy to .env only if it does not exist, then replace every <...> value.
# For the full HTTPS Docker stack, use ../envs/*.env.example instead.
# These are documentation placeholders, not runnable values or shell commands.

# Development permits configured frontend origins and local test origins.
NODE_ENV=<development>

# API port on this computer. Do not run another service on the same port.
PORT=<3000>

# Local PostgreSQL connection. The disposable postgres/ test container publishes
# POSTGRES_PORT on this computer; 5433 avoids a common local PostgreSQL port.
# Stopping that disposable test container discards its data.
POSTGRES_HOST=<127.0.0.1>
POSTGRES_PORT=<5433>
POSTGRES_USER=<nook_test>
POSTGRES_PASSWORD=<GENERATE_A_UNIQUE_TEST_DATABASE_PASSWORD>
POSTGRES_DB=<nook_users>

# RabbitMQ must be reachable for user events.
# Match the credentials of your broker (../envs/rabbitmq.env for the root stack).
RABBITMQ_HOST=<127.0.0.1>
RABBITMQ_PORT=<5672>
RABBITMQ_DEFAULT_USER=<nook_rabbitmq>
RABBITMQ_DEFAULT_PASS=<SAME_PASSWORD_AS_YOUR_RABBITMQ_BROKER>

# Generate a matching RSA pair with: node scripts/generate-jwt-keys.mjs
# Paste complete PEM contents, single-quoted, with literal \n between lines.
# Shape: '-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----'
JWT_PRIVATE_KEY=<RSA_PRIVATE_KEY_PEM_WITH_LITERAL_BACKSLASH_N>
JWT_PUBLIC_KEY=<MATCHING_RSA_PUBLIC_KEY_PEM_WITH_LITERAL_BACKSLASH_N>

# Origin of your standalone test frontend, used for OAuth returns and emails.
# The actual Next.js app uses the HTTPS Compose stack at https://localhost.
AUTH_FRONTEND_URL=<http://localhost:5173>

# All four SMTP settings are required at application startup.
# Host has no scheme. Port 465 enables implicit TLS; 587 commonly uses STARTTLS.
SMTP_HOST=<smtp.example.com>
SMTP_PORT=<587>
# This address is also used as the email sender.
SMTP_USERNAME=<noreply@example.com>
SMTP_PASSWORD=<SMTP_PROVIDER_PASSWORD_OR_APP_PASSWORD>

# Optional Discord OAuth credentials. Set both or leave both empty locally.
DISCORD_CLIENT_ID=<DISCORD_APPLICATION_CLIENT_ID>
DISCORD_CLIENT_SECRET=<DISCORD_APPLICATION_CLIENT_SECRET>

# Direct API callbacks omit /api because no Nginx prefix is involved.
# Register both exact URLs with the provider before testing login/linking.
DISCORD_REDIRECT_URI=<http://localhost:3000/auth/discord/callback>
DISCORD_LINK_REDIRECT_URI=<http://localhost:3000/auth/discord/link/callback>

# Optional GitHub OAuth credentials. Set both or leave both empty locally.
GITHUB_CLIENT_ID=<GITHUB_OAUTH_APPLICATION_CLIENT_ID>
GITHUB_CLIENT_SECRET=<GITHUB_OAUTH_APPLICATION_CLIENT_SECRET>
GITHUB_REDIRECT_URI=<http://localhost:3000/auth/github/callback>
GITHUB_LINK_REDIRECT_URI=<http://localhost:3000/auth/github/link/callback>

# Needed only if you run scripts/bootstrap-superadmin-env.mjs on a fresh DB.
# Plain start:dev does not run that bootstrap. Existing admins are not changed.
# Username: 3-30 characters. Email: valid address.
SUPERADMIN_USERNAME=<nook_admin>
SUPERADMIN_EMAIL=<admin@example.com>
# Password: 8-32 characters, at most 72 UTF-8 bytes; quote real values containing $.
SUPERADMIN_PASSWORD=<UNIQUE_ADMIN_PASSWORD_8_TO_32_CHARS>
