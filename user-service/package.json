{
  "name": "user-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "bootstrap:superadmin": "node scripts/bootstrap-superadmin.mjs",
    "bootstrap:superadmin:env": "node scripts/bootstrap-superadmin-env.mjs",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "node ../scripts/checks/user-tests.mjs",
    "test:register": "npm run build && node --test --test-isolation=none test/register-tokens.test.mjs",
    "test:auth": "npm run build && node --test --test-isolation=none test/register-tokens.test.mjs test/login-tokens.test.mjs test/current-user.test.mjs test/refresh-tokens.test.mjs",
    "test:auth:postgres": "npm run build && node --test --test-isolation=none test/refresh-race.postgres.test.mjs",
    "test:accounts": "npm run build && node --test --test-isolation=none test/accounts.test.mjs test/account-images.test.mjs",
    "test:superadmin": "npm run build && node --test --test-isolation=none test/superadmin.test.mjs test/superadmin-api.test.mjs",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:discord": "npm run build && node --test --test-isolation=none test/discord-oauth.test.mjs",
    "test:discord:postgres": "npm run build && node --env-file=.env --test --test-isolation=none test/discord-link.postgres.test.mjs",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "argon2": "^0.45.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nodemailer": "^10.0.15",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^17.2.3",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
