generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  email       String   @unique
  firstName   String?
  lastName    String?
  displayName String?  // fallback for OAuth users who skip profile setup
  avatarUrl   String?
  bannerUrl   String?
  role        UserRole   @default(USER)

  passwordHash String?  // nullable — OAuth-only users won't have one
  emailVerifiedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authProviders AuthProvider[]
  refreshTokens RefreshToken[]
  twoFactor     TwoFactorAuth?
  recoveryCodes RecoveryCode[]
  images        UserImage[]
  oauthStates   OAuthState[]
  sentFriendships     Friendship[] @relation("FriendshipRequester")
  receivedFriendships Friendship[] @relation("FriendshipAddressee")
  authTokens AuthToken[]
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model UserImage {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        UserImageKind
  data        Bytes
  contentType String
  updatedAt   DateTime      @updatedAt

  @@unique([userId, kind])
}

enum UserImageKind {
  AVATAR
  BANNER
}

model AuthProvider {
  id             String   @id @default(uuid())
  provider       Provider // GITHUB | DISCORD | FORTYTWO
  providerUserId String   // the id from that provider's system
  accessToken    String?  // encrypted at rest if you store it
  refreshToken   String?
  userId         String
  user           User     @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

model RefreshToken {
  id        String   @id @default(uuid())
  sessionId String   @default(uuid()) // shared by all rotations of one login
  tokenHash String   // never store raw refresh tokens
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, sessionId])
}

// Short-lived, single-use browser challenges for Discord OAuth callbacks.
model OAuthState {
  tokenHash   String   @id
  browserHash String
  expiresAt   DateTime
  purpose     OAuthPurpose @default(LOGIN)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

enum OAuthPurpose {
  LOGIN
  LINK
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model TwoFactorAuth {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted String
  enabledAt       DateTime?
  lastUsedStep    BigInt?
  createdAt       DateTime  @default(now())
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Provider {
  LOCAL
  GITHUB
  DISCORD
  FORTYTWO
}

enum UserRole {
  USER
  SUPERADMIN
}

model AuthToken {
  id        String          @id @default(uuid())
  tokenHash String          @unique
  purpose   AuthTokenPurpose
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
