{
  "name": "nook-code-arena",
  "version": "0.1.0",
  "description": "Code Arena, the first-game implementation baseline for Nook's ft_transcendence project.",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/arena-game",
    "packages/arena-harness",
    "packages/arena-model",
    "services/game",
    "services/judge-worker"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace arena-model && npm run build --workspace arena-game-engine && npm run build --workspace arena-game",
    "pretest": "npm run build:packages",
    "test": "node scripts/checks/arena-tests.mjs",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "lint": "node scripts/checks/verify.mjs --lint",
    "format": "npm exec --prefix user-service -- prettier --write .",
    "build": "npm run build:packages && npm run build --workspace arena-game && npm run build --workspace arena-judge-worker",
    "certs": "bash scripts/gen-dev-certs.sh",
    "play": "bash scripts/play.sh",
    "up": "docker compose up --build",
    "down": "docker compose down",
    "check": "node scripts/checks/verify.mjs",
    "test:integration": "node scripts/checks/integration.mjs",
    "evidence:g06": "node scripts/checks/g06-evidence.mjs",
    "evidence:g06:pdf": "node scripts/evidence/render-g06-pdf.mjs",
    "checks:setup": "node scripts/checks/install-scanner.mjs && node scripts/checks/install-hooks.mjs",
    "secrets:staged": "node scripts/checks/secrets.mjs staged",
    "secrets:ci": "node scripts/checks/secrets.mjs ci"
  },
  "license": "ISC"
}
