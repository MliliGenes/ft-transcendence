# Local credentials; commit only examples.
/envs/*.env

# Dependencies in the client and service workspaces.
node_modules/

# Persistent container data; keep directory placeholders.
/volumes/**
!/volumes/**/
!/volumes/**/.gitkeep

# Build output and generated code (rebuilt by each service's Dockerfile).
dist/
.next/
*.tsbuildinfo
**/src/generated/
coverage/

# Local service env files; commit only *.env.example.
**/.env
!**/.env.example

# Scratch space, logs, and the graphify cache. Keep only the root graph outputs.
.scratch/
.trigger-tree/
*.log
graphify-out/cache/
graphify-out/20*/
**/graphify-out/
!/graphify-out/

# Understand Anything: keep the graph, ignore its scratch space.
.ua/.trash-*/
.ua/tmp/
.ua/intermediate/*
!.ua/intermediate/scan-result.json
