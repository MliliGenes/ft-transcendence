# Local credentials; commit only examples.
/envs/*.env
/envs.zip
/envs/*.zip

# Dependencies in the client and service workspaces.
node_modules/

# Persistent container data; keep directory placeholders.
/volumes/**
!/volumes/**/
!/volumes/**/.gitkeep
/backups/

# Build output and generated code (rebuilt by each service's Dockerfile).
dist/
.next/
*.tsbuildinfo
**/src/generated/
coverage/

# Local service env files; commit only *.env.example.
**/.env
!**/.env.example

# Scratch space, logs, and the graphify cache. Keep only the root graph outputs.
.scratch/
.trigger-tree/
*.log
**/.DS_Store
graphify-out/cache/
graphify-out/20*/
graphify-out/.graphify_build_state.json
graphify-out/.graphify_labels.pending.json
**/graphify-out/
!/graphify-out/

# Understand Anything: keep the graph, ignore its scratch space.
.ua/.trash-*/
.ua/tmp/
.ua/intermediate/*
!.ua/intermediate/scan-result.json

# Generated development TLS material; regenerate per clone.
/infra/nginx/certs/*.key
/infra/nginx/certs/*.crt

# Local verification tools and reports.
/.playwright-mcp/
/compose.live-2v2.yaml
/.tools/
/.verification/
