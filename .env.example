# Copy to .env and replace every placeholder. Never commit real secrets.
POSTGRES_USER=arena_admin
POSTGRES_PASSWORD=change-me

# Code Arena owns one least-privilege database role and database (pgdata).
GAME_DB_NAME=game_db
GAME_DB_USER=game_user
GAME_DB_PASSWORD=change-me

# Accounts own a separate role and database on separate storage (userpgdata).
USER_DB_NAME=user_db
USER_DB_USER=user_user
USER_DB_PASSWORD=change-me

# user-service token signing (matching RSA pair, >= 2048 bits, single line
# with literal \n for newlines). Generate once, e.g.:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# then replace each real newline with \n.
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nchange-me\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nchange-me\n-----END PUBLIC KEY-----

# First-run superadmin (created only when no SUPERADMIN exists; unchanged after).
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me-8-chars-min

# Public gateway origin browsers use; must match the https:// origin served.
AUTH_FRONTEND_URL=https://localhost

# Optional OAuth providers. Empty credentials keep a provider unavailable.
# Empty callback values use AUTH_FRONTEND_URL plus the public /api/auth/ path.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITHUB_LINK_REDIRECT_URI=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_LINK_REDIRECT_URI=

# Account mail (verification + password reset).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=change-me

# Development/test identity and direct-match fixture only.
DEV_PRINCIPAL=false
RECONNECT_GRACE_MS=90000

# Local Game processes default to direct container execution. Compose
# overrides this with the private judge worker.
JUDGE_BACKEND=container
JUDGE_WORKER_TOKEN=replace-with-a-random-64-character-secret
JUDGE_WORKER_TIMEOUT_MS=930000
JUDGE_WORKER_CONCURRENCY=2
JUDGE_WORKER_MAX_QUEUE=8
JUDGE_WORKER_QUEUE_TIMEOUT_MS=30000
JUDGE_WORKER_JOB_TIMEOUT_MS=900000
JUDGE_PYTHON_IMAGE=python:3.12-slim
JUDGE_GCC_IMAGE=gcc:14-bookworm
JUDGE_DOCKER_SOCKET=/var/run/docker.sock

# Optional Judge0 adapter; Compose does not select it.
JUDGE0_URL=http://judge0-server:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_C_LANGUAGE_ID=50
JUDGE0_CPP_LANGUAGE_ID=54
JUDGE0_PYTHON_LANGUAGE_ID=71
JUDGE0_POLL_INTERVAL_MS=250
JUDGE0_MAX_POLLS=120
