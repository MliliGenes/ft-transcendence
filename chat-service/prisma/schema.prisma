generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// User service owns identity. This is only a public-profile projection.
model ChatUser {
  id              String    @id @db.Uuid
  username        String?
  displayName     String?
  avatarUrl       String?
  syncedAt        DateTime  @default(now())
  sourceUpdatedAt DateTime
  deletedAt       DateTime?

  dmsAsUserA Conversation[] @relation("DmUserA")
  dmsAsUserB Conversation[] @relation("DmUserB")
  messages   Message[]
  memberships GroupMember[]
}

// The database enforces either a canonical DM pair or a group channel.
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  kind ConversationKind @default(DM)
  lastMessageAt DateTime?
  dmUserAId String?   @db.Uuid
  dmUserBId String?   @db.Uuid
  groupId String? @db.Uuid
  name String? @db.VarChar(80)
  topic String? @db.VarChar(500)

  dmUserA ChatUser? @relation("DmUserA", fields: [dmUserAId], references: [id], onDelete: Restrict)
  dmUserB ChatUser? @relation("DmUserB", fields: [dmUserBId], references: [id], onDelete: Restrict)
  messages Message[]
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt, id])
  @@index([dmUserAId, lastMessageAt, id])
  @@index([dmUserBId, lastMessageAt, id])
  @@unique([dmUserAId, dmUserBId])
  @@index([dmUserAId, createdAt, id])
  @@index([dmUserBId, createdAt, id])
}

model Message {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @db.Uuid
  authorId        String    @db.Uuid
  content         String?   @db.VarChar(2000)
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?
  clientRequestId String    @db.Uuid
  requestHash     String    @db.Char(64)
  version         Int       @default(1)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author ChatUser @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([authorId, clientRequestId])
  @@index([conversationId, createdAt, id])
}

// Foundation storage only; group management endpoints belong to CHAT-04.
model Group {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)
  description String? @db.VarChar(1000)
  rules String? @db.VarChar(4000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members GroupMember[]
  channels Conversation[]
}

model GroupMember {
  groupId String @db.Uuid
  userId String @db.Uuid
  role GroupRole @default(MEMBER)
  joinedAt DateTime @default(now())
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user ChatUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([groupId, userId])
  @@index([userId, joinedAt, groupId])
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum ConversationKind {
  DM
  CHANNEL
}
