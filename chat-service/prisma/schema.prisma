generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// User service owns identity. This is only a public-profile projection.
model ChatUser {
  id              String    @id @db.Uuid
  username        String?
  displayName     String?
  avatarUrl       String?
  sourceUpdatedAt DateTime
  deletedAt       DateTime?

  dmsAsUserA Conversation[] @relation("DmUserA")
  dmsAsUserB Conversation[] @relation("DmUserB")
  messages   Message[]
}

// Private DMs only. Groups and reactions get separate migrations later.
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dmUserAId String   @db.Uuid
  dmUserBId String   @db.Uuid

  dmUserA ChatUser @relation("DmUserA", fields: [dmUserAId], references: [id], onDelete: Restrict)
  dmUserB ChatUser @relation("DmUserB", fields: [dmUserBId], references: [id], onDelete: Restrict)
  messages Message[]

  @@unique([dmUserAId, dmUserBId])
  @@index([dmUserAId, createdAt, id])
  @@index([dmUserBId, createdAt, id])
}

model Message {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @db.Uuid
  authorId        String    @db.Uuid
  content         String?   @db.VarChar(2000)
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?
  clientRequestId String    @db.Uuid
  requestHash     String    @db.Char(64)
  version         Int       @default(1)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author ChatUser @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([authorId, clientRequestId])
  @@index([conversationId, createdAt, id])
}
