PORT=3001
# Chat owns a separate database. Use a URL-encoded password.
DATABASE_URL=postgresql://nook_chat:REPLACE_ME@localhost:5433/nook_chat
# Copy only the existing User service PUBLIC key, never its private signing key.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_USER_SERVICE_PUBLIC_KEY\n-----END PUBLIC KEY-----"
# For the local PostgreSQL helper; use different passwords for admin and Chat.
CHAT_DB_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD
CHAT_DB_PASSWORD=REPLACE_WITH_LOCAL_CHAT_PASSWORD
# Direct User-service origin, not the public gateway.
USER_SERVICE_URL=http://localhost:3000
INTERNAL_API_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET
